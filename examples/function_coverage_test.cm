int even(int n);
int odd(int n);

int even(int n) {
    if (n == 0) return 1;
    return odd(n - 1);
}

int odd(int n) {
    if (n == 0) return 0;
    return even(n - 1);
}

int sum6(int a, int b, int c, int d, int e, int f) {
    return a + b + c + d + e + f;
}

int main(void) {
    if (even(8) != 1) return 1;
    if (odd(7) != 1) return 2;
    if (even(7) != 0) return 3;
    if (sum6(1, 2, 3, 4, 5, 6) != 21) return 4;
    return 0;
}
