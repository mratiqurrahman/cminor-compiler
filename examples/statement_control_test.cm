int main(void) {
    int i = 0;
    int sum = 0;

    while (i < 10) {
        i = i + 1;
        if (i == 2) continue;
        if (i == 6) break;
        sum = sum + i;
    }

    if (i != 6) return 1;
    if (sum != 13) return 2;

    int count = 0;
    for (int j = 0; j < 10; j = j + 1) {
        if (j == 4) break;
        count = count + 1;
    }

    if (count != 4) return 3;

    int outer = 0;
    int inner = 0;

    while (outer < 3) {
        outer = outer + 1;
        inner = 0;

        while (inner < 5) {
            inner = inner + 1;
            if (inner == 2) break;
        }

        if (inner != 2) return 4;
    }

    if (outer != 3) return 5;

    return 0;
}
