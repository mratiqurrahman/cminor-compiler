int factorial(int n);
int sum_to(int n);
int main(void) {
    int total = sum_to(5);
    int fact = factorial(5);
    if (total != 15) return 1;
    if (fact != 120) return 2;
    return 0;
}
int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
int sum_to(int n) {
    int result = 0;
    for (int i = 1; i <= n; i = i + 1) {
        result = result + i;
    }
    return result;
}
